# ---- Backend (Railway service variables, or .env locally) ----
# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The secret / service_role key. SERVER ONLY. Never put it in a VITE_ variable.
SUPABASE_SECRET_KEY=

# Optional: folder for uploads/prepared files (use a Railway volume path, e.g. /data)
# DATA_DIR=/data

# ---- Frontend (build-time; only needed on Vercel / Netlify) ----
# Full URL of your Railway API, including /api and no trailing slash
# VITE_API_URL=https://your-app.up.railway.app/api
